#deb cdrom:[Debian GNU/Linux 13.3.0 _Trixie_ - Official amd64 NETINST with firmware 20260110-10:59]/ trixie contrib main non-free-firmware

deb http://ftp.halifax.rwth-aachen.de/debian/ trixie main contrib non-free-firmware non-free
deb-src http://ftp.halifax.rwth-aachen.de/debian/ trixie main contrib non-free-firmware non-free

deb http://security.debian.org/debian-security trixie-security main contrib non-free-firmware non-free
deb-src http://security.debian.org/debian-security trixie-security main contrib non-free-firmware non-free

# trixie-updates, to get updates before a point release is made;
# see https://www.debian.org/doc/manuals/debian-reference/ch02.en.html#_updates_and_backports
deb http://ftp.halifax.rwth-aachen.de/debian/ trixie-updates main contrib non-free-firmware non-free
deb-src http://ftp.halifax.rwth-aachen.de/debian/ trixie-updates main contrib non-free-firmware non-free

