#######################  Console setup ############################

#Encoding: UTF-8
#Character Set: Combined - Latin; Slavic and Greek (or use the default)
#Font: Terminus
#Size: 16x32 or TerminusBold 16x32

sudo dpkg-reconfigure console-setup

#######################  Network setup ############################

ip -brief link
ip -brief link | cut -d' ' -f1 | grep -v lo
ip addr show $( ip -brief link | cut -d' ' -f1 | grep -v lo)
#ip addr show enp0s25
sudo nano /etc/network/interfaces
sudo systemctl restart networking

journalctl -u networking --no-pager -n 20
ping -c 3 google.de

#################### check Installation ###########################

ping -c 3 google.de
sudo dpkg --configure -a > output.txt
echo >> output.txt
sudo apt clean >> output.txt
sudo apt update >> output.txt
sudo apt install -f >> output.txt

sudo dpkg --audit
dpkg -l | grep ^[ihr] > install_check.txt

echo >> output.txt
ps aux --sort=%mem  >> output.txt 

echo >> output.txt
mount | grep " / " >> output.txt 

####################### some useful commands ######################

