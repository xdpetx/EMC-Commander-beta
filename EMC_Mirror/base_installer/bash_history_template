mkdir -p ~/.config ~/.local/share ~/Downloads
ls -la
sudo /sbin/reboot 
sudo /sbin/shutdown now

#######################  Install EMC ##############################

# first make some directories ...
mkdir -p ~/.config ~/.local/share ~/Downloads
# then go to your Download dir
cd $HOME/Downloads/
# extract EMC installer
tar -xvf EMC_INSTALL_standalone.tar.gz -C ~
# and run installation
$HOME/EMC_install/EMC_standalone_base_installer.sh
# start EMC
startx

###################### copy Archive from USB ######################

# first identify your usb stick
lsblk -o NAME,MODEL,SIZE,RM,TYPE,TRAN -n
# create /mnt directory
sudo mkdir -p /mnt
# then mount the stick
sudo mount /dev/your_usb_partition /mnt
# make some directories ...
mkdir -p ~/.config ~/.local/share ~/Downloads
